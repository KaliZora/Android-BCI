def ensure_system_tools(*, dry_run: bool) -> None:
    if dry_run:
        log("DRY", "(würde System-Toolchain prüfen)")
        return

    if IS_TERMUX:
        # lld wird für potenzielle LTO-Builds und für termux-elf-cleaner-Umfeld
        # empfohlen. --lto=no auf Termux verhindert den harten Bedarf, aber
        # das Paket schadet nicht und deckt künftige Backends ab.
        needed = ["clang", "termux-elf-cleaner", "cmake", "ninja", "patchelf", "lld"]
        missing = [t for t in needed if not shutil.which(t)]
        if missing:
            log("INFO", f"Fehlende Termux-Pakete: {missing}")
            run_cmd(
                ["pkg", "install", "-y"] + missing,
                check=False,
            )
        return

    if IS_LINUX:
        if not shutil.which("clang"):
            log("WARN", "clang nicht gefunden. Installiere: sudo apt install clang")
        # lld ist für --lto=yes erforderlich
        if not (shutil.which("lld") or shutil.which("ld.lld")):
            log("WARN", "lld nicht gefunden — Nuitka --lto=yes scheitert.")
            log("WARN", "  Debian/Ubuntu: sudo apt install lld")
            log("WARN", "  Fedora:        sudo dnf install lld")
            log("WARN", "  Arch:          sudo pacman -S lld")
    if IS_DARWIN and not shutil.which("clang"):
        log("WARN", "Xcode Command Line Tools fehlen (xcode-select --install).")
    if IS_WINDOWS:
        log("INFO", "Windows: Nuitka nutzt MSVC (Visual Studio Build Tools nötig).")


# ---------------------------------------------------------------------------
# Workspace und Python-Toolchain
# ---------------------------------------------------------------------------

def setup_workspace(*, dry_run: bool) -> Path:
    if not dry_run:
        WORKSPACE.mkdir(parents=True, exist_ok=True)

    if IS_TERMUX:
        log("INFO", "Termux: System-Python (kein venv).")
        return Path(sys.executable)

    venv = WORKSPACE / ".venv"
    if not dry_run and not venv.exists():
        run_cmd([sys.executable, "-m", "venv", str(venv)])
    if IS_WINDOWS:
        return venv / "Scripts" / "python.exe"
    return venv / "bin" / "python"


def install_pip_toolchain(py_bin: Path, *, dry_run: bool) -> None:
    pip = [py_bin, "-m", "pip", "install"]
    if IS_TERMUX:
        pip.append("--break-system-packages")

    log("INFO", "Aktualisiere pip/setuptools/wheel...")
    run_cmd(pip + ["--upgrade"] + PIP_CORE, dry_run=dry_run)

    log("INFO", "Installiere Nuitka und BrainFlow...")
    run_cmd(pip + PIP_AOT + PIP_BCI, dry_run=dry_run)

    log("INFO", "Installiere zlib-ng (Kompression, optional)...")
    run_cmd(pip + PIP_COMPRESSION, dry_run=dry_run, check=False)


