def kotlin_termux_status() -> tuple[bool, str]:
    env = os.environ.get(KOTLIN_ENV_VAR, "").strip().lower()
    if env == "1":
        return True, f"Env {KOTLIN_ENV_VAR}=1"
    if env == "0":
        return False, f"Env {KOTLIN_ENV_VAR}=0"
    if KOTLIN_MARKER.exists():
        return True, f"Marker {KOTLIN_MARKER}"
    if shutil.which("adb"):
        try:
            r = adb(["shell", "pm", "list", "packages", "com.termux"], timeout=10)
            if "com.termux.kotlin" in r.stdout:
                return True, "ADB: com.termux.kotlin installiert"
            if "com.termux" in r.stdout:
                return False, "ADB: nur com.termux (Standard) installiert"
        except Exception:
            pass
    return False, "keine Kotlin-Indikatoren gefunden"


def verify_adb() -> bool:
    if not shutil.which("adb"):
        log("ERR", "adb nicht gefunden. Installiere: pkg install android-tools")
        return False
    try:
        r = subprocess.run(
            ["adb", "devices"], capture_output=True, text=True, timeout=10,
        )
    except Exception as e:
        log("ERR", f"adb devices fehlgeschlagen: {e}")
        return False
    if ADB_TARGET not in r.stdout:
        log("ERR", f"Gerät {ADB_TARGET} nicht verbunden.")
        log("INFO", "Aktiviere Wireless Debugging, dann:")
        log("INFO", "  adb pair <ip>:<port>   # Code aus Android-Dialog")
        log("INFO", f"  adb connect {ADB_TARGET}")
        return False
    return True


def create_backup(*, dry_run: bool = False) -> Path | None:
    if dry_run:
        log("DRY", f"(würde Backup in {BACKUP_DIR} erstellen)")
        return None

    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    backup_file = BACKUP_DIR / f"termux-backup-{stamp}.tar.gz"

    if IS_TERMUX and shutil.which("termux-setup-storage"):
        run_cmd(["termux-setup-storage"], check=False, timeout=60)

    log("INFO", f"Erstelle Backup: {backup_file}")
    try:
        r = subprocess.run(
            [
                "tar", "-zcf", str(backup_file),
                "-C", "/data/data/com.termux/files",
                "home", "usr",
            ],
            capture_output=True, text=True, timeout=600,
        )
    except Exception as e:
        log("ERR", f"Backup-Aufruf fehlgeschlagen: {e}")
        return None

    if r.returncode != 0 or not backup_file.exists() or backup_file.stat().st_size == 0:
        log("ERR", f"Backup fehlgeschlagen (rc={r.returncode}): {r.stderr.strip()}")
        return None

    size_mb = backup_file.stat().st_size / (1024 * 1024)
    log("OK", f"Backup erstellt: {backup_file} ({size_mb:.1f} MB)")
    return backup_file


def download_kotlin_apk() -> Path | None:
    log("INFO", "Suche neueste Kotlin-Termux-Release...")
    api = f"https://api.github.com/repos/{KOTLIN_REPO}/releases/latest"
    try:
        req = urllib.request.Request(api, headers={"User-Agent": "bci-orchestrator"})
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read().decode())
    except Exception as e:
        log("ERR", f"GitHub-API-Fehler: {e}")
        return None

    assets = data.get("assets", [])
    apk = next(
        (a for a in assets
         if "arm64" in a["name"].lower() and a["name"].lower().endswith(".apk")),
        None,
    )
    if not apk:
        log("ERR", "Kein arm64-v8a APK-Asset gefunden.")
        return None

    KOTLIN_DOWNLOAD_PATH.parent.mkdir(parents=True, exist_ok=True)
    log("INFO", f"Lade {apk['name']} ({apk.get('size', 0)//1024} KB)...")
    try:
        urllib.request.urlretrieve(apk["browser_download_url"], KOTLIN_DOWNLOAD_PATH)
    except Exception as e:
        log("ERR", f"Download fehlgeschlagen: {e}")
        return None

    log("OK", f"APK gespeichert: {KOTLIN_DOWNLOAD_PATH}")
    return KOTLIN_DOWNLOAD_PATH


def install_apk_via_adb(apk: Path) -> bool:
    remote = "/data/local/tmp/termux_kotlin.apk"
    try:
        r = subprocess.run(
            ["adb", "-s", ADB_TARGET, "push", str(apk), remote],
            capture_output=True, text=True, timeout=120,
        )
        if r.returncode != 0:
            log("ERR", f"adb push fehlgeschlagen: {r.stderr.strip()}")
            return False

        r = adb(["shell", "pm", "install", "-r", "-d", remote], timeout=180)
        if "Success" in r.stdout:
            log("OK", "APK via ADB installiert.")
            return True
        log("ERR", f"pm install: {r.stdout.strip() or r.stderr.strip()}")
        return False
    except Exception as e:
        log("ERR", f"ADB-Installation fehlgeschlagen: {e}")
        return False


def install_apk_via_su(apk: Path) -> bool:
    if not shutil.which("su"):
        return False
    try:
        r = subprocess.run(
            ["su", "-c", f"pm install -r -d {shlex.quote(str(apk))}"],
            capture_output=True, text=True, timeout=180,
        )
        if "Success" in r.stdout:
            log("OK", "APK via su installiert.")
            return True
        log("ERR", f"su: {r.stdout.strip() or r.stderr.strip()}")
        return False
    except Exception as e:
        log("ERR", f"su-Installation fehlgeschlagen: {e}")
        return False


def enforce_kotlin_termux(*, migrate: bool, dry_run: bool) -> int:
    if not IS_TERMUX:
        return 0

    is_kotlin, reason = kotlin_termux_status()
    if is_kotlin:
        log("OK", f"Kotlin-Termux erkannt ({reason}).")
        return 0

    log("WARN", f"Kotlin-Termux nicht erkannt ({reason}).")
    log("WARN", "Kotlin-Termux ist auf diesem Gerät verbindlich.")

    if not migrate:
        log("ERR", "Migration nicht angefordert. Nutze --migrate.")
        log("INFO", "Alternativ: --force-legacy oder --skip-kotlin-check")
        return 3

    if dry_run:
        log("DRY", "(würde Backup, Download und Installation durchführen)")
        return 0

    log("INFO", "Backup ist für die Migration zwingend erforderlich.")
    backup = create_backup()
    if backup is None:
        log("ERR", "Backup fehlgeschlagen — Migration abgebrochen.")
        return 3

    apk = download_kotlin_apk()
    if apk is None:
        log("ERR", "APK-Download fehlgeschlagen.")
        log("INFO", f"Manueller Download: https://github.com/{KOTLIN_REPO}/releases")
        return 3

    installed = False
    if verify_adb():
        installed = install_apk_via_adb(apk)
    if not installed:
        installed = install_apk_via_su(apk)

    if not installed:
        log("ERR", "Automatische Installation fehlgeschlagen.")
        log("INFO", "Manuelle Installation:")
        log("INFO", f"  1. Öffne: {apk}")
        log("INFO", "  2. Erlaube Installation aus unbekannten Quellen")
        log("INFO", f"  3. Wiederherstellen: tar -xzf {backup} -C /data/data/com.termux/files")
        return 3

    log("OK", "Kotlin-Termux installiert.")
    log("WARN", "Termux-Session muss neu gestartet werden.")
    log("INFO", f"Nach Neustart: tar -xzf {backup} -C /data/data/com.termux/files")
    return 10


