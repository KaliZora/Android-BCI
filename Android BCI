def patch_elf(binary: Path | None, *, dry_run: bool) -> None:
    if not IS_TERMUX:
        return
    if binary is None:
        if dry_run:
            log("DRY", "(würde ELF patchen, sobald Binärdatei existiert)")
        return
    if not shutil.which("termux-elf-cleaner"):
        log("WARN", "termux-elf-cleaner fehlt — Android 14+ könnte fehlschlagen.")
        return
    log("INFO", "Patche ELF (PT_GNU_RELRO, API 24)...")
    run_cmd(
        ["termux-elf-cleaner", "--api-level", "24", str(binary)],
        check=False, dry_run=dry_run,
    )


def smoke_test(binary: Path | None, *, dry_run: bool = False) -> bool:
    log("INFO", "Smoke-Test: --self-test")
    if dry_run:
        log("DRY", f"(würde {binary} --self-test ausführen)")
        return True
    if binary is None or not binary.exists():
        log("ERR", "Smoke-Test: Binärdatei nicht vorhanden.")
        return False

    try:
        r = subprocess.run(
            [str(binary), "--self-test"],
            capture_output=True, text=True, timeout=60,
        )
    except subprocess.TimeoutExpired:
        log("ERR", "Smoke-Test Timeout (60s).")
        return False
    except Exception as e:
        log("ERR", f"Smoke-Test konnte nicht starten: {e}")
        return False

    if r.returncode != 0 or "SELF_TEST_OK" not in r.stdout:
        log("ERR", f"Smoke-Test rc={r.returncode}")
        for line in (r.stderr or r.stdout or "").strip().splitlines():
            log("ERR", f"  {line}")
        return False

    log("OK", "Smoke-Test bestanden.")
    for line in r.stdout.strip().splitlines():
        log("INFO", f"  {line}")
    return True


def package_artifact(src: Path, dest: Path, *, dry_run: bool) -> bool:
    if dry_run:
        log("DRY", f"(würde {src} nach {dest} packen)")
        return True

    import io
    import tarfile

    log("INFO", f"Packe {src} → {dest}")
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w") as tar:
        tar.add(src, arcname=src.name)
    raw = buf.getvalue()

    try:
        import zlib_ng.gzip_ng as gz  # type: ignore
        compressed = gz.compress(raw, level=6)
        backend = "zlib-ng"
    except ImportError:
        try:
            import deflate  # type: ignore
            compressed = deflate.gzip_compress(raw, level=6)
            backend = "libdeflate"
            log("WARN", "libdeflate: schneller, aber kein Streaming.")
        except ImportError:
            import gzip
            compressed = gzip.compress(raw, compresslevel=6)
            backend = "stdlib gzip"

    dest.write_bytes(compressed)
    log("OK", f"Artefakt ({backend}): {dest} ({len(compressed):,} Bytes)")
    return True


