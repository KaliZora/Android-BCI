    NoiseEstimationLevelTypes,
)


# Wavelet-Denoising erfordert mindestens 64 Samples pro Kanal (BIOR3_9, level 3).
MIN_WAVELET_SAMPLES = 64


class URMLIntentGate:
    """Fail-closed Gate: STATE_REST dispatcht nur mit --dispatch-rest.

    Konfidenz-Formel (Notebook-Vorlage):
        confidence = clip((dominance - 0.5) * 2, 0, 1)
    wobei dominance = max(alpha, beta) / (alpha + beta).
    Bei threshold 0.80 muss das dominante Band ~9x so stark sein wie das andere.
    """

    def __init__(self, threshold: float = 0.55, allow_rest: bool = False):
        self.threshold = float(max(0.0, min(1.0, threshold)))
        self.allow_rest = allow_rest

    def evaluate(self, intent: str, confidence: float) -> str:
        ts = time.time_ns()
        if intent == "HOLD":
            print(f"[{ts}] [HOLD] {intent} REJECTED (Conf: {confidence:.4f})")
            return "HOLD"
        if intent == "STATE_REST" and not self.allow_rest:
            print(f"[{ts}] [HOLD] {intent} BLOCKED (fail-closed, "
                  f"Conf: {confidence:.4f})")
            return "HOLD"
        if confidence > self.threshold:
            print(f"[{ts}] [DISPATCH] {intent} (Conf: {confidence:.4f})")
            return intent
        print(f"[{ts}] [HOLD] {intent} BELOW THRESHOLD "
              f"(Conf: {confidence:.4f}, Thresh: {self.threshold:.4f})")
        return "HOLD"


def compute_intent(bands: np.ndarray) -> tuple[str, float]:
    """Notebook-Konfidenz: clip((dominance - 0.5) * 2, 0, 1)."""
    alpha = float(max(bands[2], 0.0))
    beta = float(max(bands[3], 0.0))
    total = alpha + beta + 1e-9

    alpha_ratio = alpha / total
    beta_ratio = beta / total

    if beta_ratio >= alpha_ratio:
        intent = "FOCUS_ACTIVE"
        dominance = beta_ratio
    else:
        intent = "STATE_REST"
        dominance = alpha_ratio

    confidence = float(np.clip((dominance - 0.5) * 2.0, 0.0, 1.0))
    return intent, confidence


def validate_data_integrity(data: np.ndarray, eeg_channels: list,
                            required_samples: int) -> bool:
    """Fail-Closed Hardware-Verträge auf EEG-Kanälen.

    Prüft: Anzahl, NaN/Inf, Flatline, Sättigung (> 200 mV).
    """
    if data.ndim != 2 or data.shape[1] < required_samples:
        return False
    eeg_data = data[eeg_channels]
    if not np.isfinite(eeg_data).all():
        return False
    if eeg_data.shape[1] > 1:
        diffs = np.diff(eeg_data, axis=1)
        if (diffs == 0).all(axis=1).any():
            return False
    if np.abs(eeg_data).max() > 200000.0:
        return False
    return True


def run_dsp_pipeline(board_id, port, notch, threshold, dispatch_rest, duration):
    print("--- BCI DSP PIPELINE ---")
    print(f"BrainFlow {brainflow.__version__} | NumPy {np.__version__}")

    params = BrainFlowInputParams()
    if port:
        params.serial_port = port

    board = BoardShim(board_id, params)
    gate = URMLIntentGate(threshold=threshold, allow_rest=dispatch_rest)

    try:
        board.prepare_session()
    except Exception as e:
        print(f"[FATAL] prepare_session: {e}", file=sys.stderr)
        return 1

    try:
        board.start_stream(45000)
        srate = BoardShim.get_sampling_rate(board_id)
        eeg = BoardShim.get_eeg_channels(board_id)

        nyquist = srate / 2.0
        upper = min(45.0, 0.95 * nyquist)
        if nyquist <= 45.0:
            print(f"[WARN] Nyquist {nyquist:.1f}Hz — "
                  f"oberer Cutoff auf {upper:.2f}Hz")

        # Harte Wavelet-Fensterprüfung (aus Notebook-Vorlage).
        w_size = int(srate * 2)
        if w_size < MIN_WAVELET_SAMPLES:
            raise RuntimeError(
                f"Sampling rate {srate}Hz too low for wavelet window "
                f"(need w_size >= {MIN_WAVELET_SAMPLES}, got {w_size})"
            )

        print(f"Locked: {srate}Hz | Nyquist {nyquist}Hz | "
              f"{len(eeg)} EEG-Kanäle | w_size {w_size}")
        if duration > 0:
            print(f"Duration: {duration}s")

        start = time.time()
        while True:
            if duration > 0 and (time.time() - start) >= duration:
                print(f"[*] Duration {duration}s erreicht.")
                break
            time.sleep(0.5)
            data = board.get_current_board_data(w_size)
            if not validate_data_integrity(data, eeg, w_size):
                gate.evaluate("HOLD", 0.0)
                continue

            for ch in eeg:
                DataFilter.detrend(data[ch], DetrendOperations.CONSTANT.value)
                DataFilter.perform_bandstop(
                    data[ch], srate, notch - 2.0, notch + 2.0,
                    3, FilterTypes.BUTTERWORTH_ZERO_PHASE.value, 0,
                )
                DataFilter.perform_bandpass(
                    data[ch], srate, 0.5, upper,
                    4, FilterTypes.BUTTERWORTH_ZERO_PHASE.value, 0,
                )
                # Wavelet-Denoising — nur bei ausreichender Länge.
                if len(data[ch]) >= MIN_WAVELET_SAMPLES:
                    DataFilter.perform_wavelet_denoising(
                        data[ch],
                        WaveletTypes.BIOR3_9.value,
                        3,
                        WaveletDenoisingTypes.SURESHRINK.value,
                        ThresholdTypes.SOFT.value,
                        WaveletExtensionTypes.SYMMETRIC.value,
                        NoiseEstimationLevelTypes.FIRST_LEVEL.value,
                    )

            bands = DataFilter.get_avg_band_powers(
                data, eeg, srate, False,
            )[0]
            intent, confidence = compute_intent(bands)
            gate.evaluate(intent, confidence)
    except KeyboardInterrupt:
        print("[*] Abgebrochen.")
        return 0
    except Exception as e:
        print(f"[FATAL] Stream: {e}", file=sys.stderr)
        return 1
    finally:
        try:
            if board.is_prepared():
                board.stop_stream()
                board.release_session()
        except Exception:
            pass
    return 0


