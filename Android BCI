def get_brainflow_dir(py_bin: Path, *, dry_run: bool = False) -> Path | None:
    if dry_run:
        log("DRY", f"(würde BrainFlow-Verzeichnis mit {py_bin} ermitteln)")
        return None
    try:
        r = run_cmd(
            [py_bin, "-c", "import brainflow; print(brainflow.__path__[0])"],
            capture=True,
        )
        path = Path(r.stdout.strip())
        return path if path.exists() else None
    except Exception:
        return None


def nuitka_flags() -> list[str]:
    flags = ["--standalone", "--remove-output"]
    if IS_TERMUX:
        flags += ["--low-memory", "--jobs=1", "--clang", "--lto=no"]
    elif IS_WINDOWS:
        flags += [f"--jobs={min(CPU_COUNT, 4)}", "--msvc=latest"]
    else:
        flags += [f"--jobs={min(CPU_COUNT, 4)}", "--clang", "--lto=yes"]

    flags += [
        "--include-package=brainflow",
        "--include-package=numpy",
        "--include-package-data=numpy",
    ]
    return flags


def compile_binary(py_bin: Path, *, dry_run: bool) -> Path | None:
    log("INFO", "Starte Nuitka AOT-Kompilierung...")
    BIN_DIR.mkdir(parents=True, exist_ok=True)

    flags = nuitka_flags()

    bf_dir = get_brainflow_dir(py_bin, dry_run=dry_run)
    if bf_dir:
        flags.append(f"--include-data-dir={bf_dir}=brainflow")
        log("INFO", f"BrainFlow-Datenverzeichnis eingebunden: {bf_dir}")
    else:
        log("WARN", "BrainFlow-Verzeichnis nicht ermittelbar — "
                    "Fallback auf --include-package.")

    cmd = [py_bin, "-m", "nuitka", f"--output-dir={BIN_DIR}"] + flags + [str(BCI_SRC)]

    if dry_run:
        log("DRY", " ".join(shlex.quote(str(c)) for c in cmd))
        return None

    proc = subprocess.Popen(
        [str(c) for c in cmd],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
    )
    for line in iter(proc.stdout.readline, ""):
        sys.stdout.write(f"    {line}")
    proc.wait()

    if proc.returncode != 0:
        log("ERR", f"Nuitka fehlgeschlagen (rc={proc.returncode}).")
        return None

    for cand in [
        BIN_DIR / f"{BCI_SRC.stem}.bin",
        BIN_DIR / BCI_SRC.stem,
        BIN_DIR / f"{BCI_SRC.stem}.exe",
    ]:
        if cand.exists():
            log("OK", f"Binärdatei: {cand}")
            return cand
    log("ERR", "Nuitka meldete Erfolg, aber keine Binärdatei gefunden.")
    return None


