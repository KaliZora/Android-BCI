PYTHON_MIN = (3, 10)
PYTHON_MAX = (3, 13)  # exklusiv


def check_python_version() -> None:
    """Bricht hart ab, wenn die Python-Version außerhalb [3.10, 3.13) liegt.

    Grund: numpy<2 und brainflow==5.23.0 haben für 3.13+ keine Wheels. Der
    Build würde erst spät und mit kryptischen Fehlern scheitern.
    """
    v = sys.version_info[:2]
    if v < PYTHON_MIN or v >= PYTHON_MAX:
        log(
            "ERR",
            f"Python {PYTHON_MIN[0]}.{PYTHON_MIN[1]}–{PYTHON_MAX[0]}.{PYTHON_MAX[1]-1} "
            f"erforderlich, gefunden {sys.version.split()[0]}.",
        )
        log(
            "ERR",
            "numpy<2 und brainflow==5.23.0 haben für diese Version keine Wheels.",
        )
        log("ERR", "Installiere z.B. Python 3.11/3.12 oder nutze ein venv.")
        sys.exit(2)


