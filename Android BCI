def check_environment() -> int:
    log("CHECK", "Prüfe Umgebung...")
    issues = 0

    v = sys.version_info[:2]
    if PYTHON_MIN <= v < PYTHON_MAX:
        log("OK", f"Python {sys.version.split()[0]}")
    else:
        log("WARN", f"Python {sys.version.split()[0]} – benötigt 3.10–3.12")
        issues += 1

    if IS_TERMUX:
        log("OK", "Termux erkannt.")
        is_kotlin, reason = kotlin_termux_status()
        if is_kotlin:
            log("OK", f"Kotlin-Termux: {reason}")
        else:
            log("WARN", f"Kotlin-Termux nicht erkannt ({reason}). Nutze --migrate.")
            issues += 1
    else:
        log("INFO", f"Kein Termux ({SYSTEM}/{ARCH}).")

    try:
        import brainflow  # noqa: F401
        log("OK", "BrainFlow importierbar.")
    except ImportError:
        log("WARN", "BrainFlow fehlt – --setup ausführen.")
        issues += 1

    if shutil.which("clang") or IS_WINDOWS:
        log("OK", "clang (oder MSVC) verfügbar.")
    else:
        log("WARN", "clang fehlt – --setup ausführen.")
        issues += 1

    # lld nur relevant, wenn --lto=yes aktiv wird (Linux/macOS, nicht Termux/Win)
    if IS_LINUX and not IS_TERMUX:
        if shutil.which("lld") or shutil.which("ld.lld"):
            log("OK", "lld verfügbar (LTO-Linker).")
        else:
            log("WARN", "lld fehlt – von Nuitka --lto=yes benötigt.")
            log("WARN", "  Debian/Ubuntu: sudo apt install lld")
            issues += 1

    if IS_TERMUX:
        if shutil.which("termux-elf-cleaner"):
            log("OK", "termux-elf-cleaner vorhanden.")
        else:
            log("WARN", "termux-elf-cleaner fehlt – Android 14+ braucht es.")
            issues += 1

    try:
        target = WORKSPACE if WORKSPACE.exists() else Path.home()
        _, _, free = shutil.disk_usage(target)
        free_gb = free / (1024 ** 3)
        if free_gb >= 2.0:
            log("OK", f"Freier Speicher: {free_gb:.1f} GB")
        else:
            log("WARN", f"Nur {free_gb:.1f} GB frei – Kompilierung braucht ~2 GB.")
            issues += 1
    except Exception:
        pass

    try:
        import zlib_ng  # noqa: F401
        log("OK", "zlib-ng verfügbar.")
    except ImportError:
        log("INFO", "zlib-ng fehlt – Fallback auf gzip.")

    log("CHECK", "Status: OK" if issues == 0 else f"Status: {issues} Problem(e)")
    return 0 if issues == 0 else 1


